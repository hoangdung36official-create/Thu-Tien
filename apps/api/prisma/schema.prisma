generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  login          String   @unique
  name           String
  role           String   @default("NV")
  active         Boolean  @default(true)
  passwordHash   String?
  legacySalt     String?
  legacyHash     String?
  sessionVersion Int      @default(1)
  houses         UserHouse[]
  accounts       UserAccount[]
  sessions       Session[]
  receipts       Receipt[] @relation("Creator")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model UserHouse {
  userId String
  houseCode String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, houseCode])
}

model UserAccount {
  userId String
  accountName String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, accountName])
}

model Session {
  tokenHash String @id
  userId String
  version Int
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}

model LoginAttempt {
  key       String   @id
  attempts  Int      @default(0)
  expiresAt DateTime
  updatedAt DateTime @updatedAt
  @@index([expiresAt])
}

model Lease {
  key       String   @id
  token     String
  expiresAt DateTime
  updatedAt DateTime @updatedAt
  @@index([expiresAt])
}

model House {
  code String @id
  name String @default("")
  note String @default("")
  active Boolean @default(true)
  sheetFingerprint String?
  updatedAt DateTime @updatedAt
}

model BankAccount {
  name String @id
  owner String @default("")
  bank String @default("")
  number String @default("")
  note String @default("")
  active Boolean @default(true)
  sheetFingerprint String?
  updatedAt DateTime @updatedAt
}

model Due {
  id String @id @default(uuid())
  month String
  houseCode String
  room String
  amount BigInt
  sheetRow Int?
  sheetColumn Int?
  syncedAt DateTime @default(now())
  @@unique([month, houseCode, room])
  @@index([month, houseCode])
}

model Receipt {
  id String @id
  month String
  houseCode String
  room String
  collector String
  payer String @default("")
  amount BigInt
  method String
  accountName String?
  receivedAt DateTime
  transferAt DateTime?
  transferMemo String @default("")
  note String @default("")
  status String @default("ACTIVE")
  syncStatus String @default("PENDING")
  source String @default("APP")
  sheetRow Int?
  sheetFingerprint String?
  createdById String?
  createdBy User? @relation("Creator", fields: [createdById], references: [id])
  updatedById String?
  version Int @default(1)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([month,houseCode,room,status])
  @@index([method,accountName,transferAt])
  @@index([syncStatus])
}

model Outbox {
  id String @id @default(uuid())
  receiptId String @unique
  version Int
  operation String
  status String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  error String?
  updatedAt DateTime @updatedAt
}

model CatalogOutbox {
  key String @id
  kind String
  status String @default("PENDING")
  attempts Int @default(0)
  error String?
  updatedAt DateTime @updatedAt
}

model Conflict {
  id String @id @default(uuid())
  entityType String
  entityId String
  reason String
  localValue Json?
  sheetValue Json?
  resolved Boolean @default(false)
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  @@index([resolved,entityType])
}

model Audit {
  id String @id @default(uuid())
  actorId String?
  actorLogin String
  action String
  entityId String?
  before Json?
  after Json?
  createdAt DateTime @default(now())
  @@index([entityId,createdAt])
}

model SyncState {
  key String @id
  value String
  updatedAt DateTime @updatedAt
}

// Independent asset and inventory domain. No financial ledger or Google Sheet relations.
model AssetSequence {
  prefix String @id
  nextNo Int @default(1)
}

model Asset {
  id String @id @default(uuid())
  code String @unique
  category String
  name String
  brand String @default("")
  model String @default("")
  purchaseDate DateTime?
  purchaseCost BigInt?
  warrantyUntil DateTime?
  conditionPct Int @default(100)
  status String @default("AVAILABLE")
  locationType String @default("CENTRAL")
  houseCode String?
  room String?
  note String @default("")
  imageUrl String?
  version Int @default(1)
  createdById String?
  updatedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  movements AssetMovement[]
  rentals EquipmentRental[]
  maintenance AssetMaintenance[]
  @@index([houseCode, room])
  @@index([category, status])
}

model AssetMovement {
  id String @id @default(uuid())
  assetId String
  asset Asset @relation(fields:[assetId],references:[id],onDelete:Restrict)
  fromType String
  fromHouse String?
  fromRoom String?
  toType String
  toHouse String?
  toRoom String?
  reason String
  actorId String
  createdAt DateTime @default(now())
  requestKey String @unique
  @@index([assetId,createdAt])
}

model EquipmentRental {
  id String @id @default(uuid())
  assetId String
  asset Asset @relation(fields:[assetId],references:[id],onDelete:Restrict)
  houseCode String
  room String
  startAt DateTime
  expectedEndAt DateTime?
  endedAt DateTime?
  monthlyFee BigInt @default(0)
  included Boolean @default(false)
  handoverNote String @default("")
  handoverDoc String?
  returnNote String @default("")
  actorId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([houseCode,room,endedAt])
  @@index([assetId,endedAt])
}

model Supply {
  id String @id @default(uuid())
  sku String @unique
  name String
  category String
  unit String
  referencePrice BigInt @default(0)
  minimumQty Int @default(0)
  note String @default("")
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  balances StockBalance[]
  movements StockMovement[]
  countLines StockCountLine[]
}

model StockBalance {
  id String @id @default(uuid())
  supplyId String
  supply Supply @relation(fields:[supplyId],references:[id],onDelete:Restrict)
  locationKey String
  quantity Int @default(0)
  updatedAt DateTime @updatedAt
  @@unique([supplyId,locationKey])
  @@index([locationKey])
}

model StockMovement {
  id String @id @default(uuid())
  supplyId String
  supply Supply @relation(fields:[supplyId],references:[id],onDelete:Restrict)
  operation String
  quantity Int
  fromKey String?
  toKey String?
  reason String
  workRef String?
  actorId String
  approverId String?
  requestKey String @unique
  createdAt DateTime @default(now())
  @@index([supplyId,createdAt])
}

model StockCount {
  id String @id @default(uuid())
  locationKey String
  status String @default("DRAFT")
  note String @default("")
  actorId String
  approverId String?
  createdAt DateTime @default(now())
  approvedAt DateTime?
  lines StockCountLine[]
  @@index([status,locationKey])
}

model StockCountLine {
  id String @id @default(uuid())
  countId String
  count StockCount @relation(fields:[countId],references:[id],onDelete:Restrict)
  supplyId String
  supply Supply @relation(fields:[supplyId],references:[id],onDelete:Restrict)
  expectedQty Int
  actualQty Int
  @@unique([countId,supplyId])
}

model AssetMaintenance {
  id String @id @default(uuid())
  assetId String
  asset Asset @relation(fields:[assetId],references:[id],onDelete:Restrict)
  kind String
  status String @default("OPEN")
  description String
  cost BigInt @default(0)
  startedAt DateTime @default(now())
  completedAt DateTime?
  actorId String
  note String @default("")
  @@index([assetId,status])
}
