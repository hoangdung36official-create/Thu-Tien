{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "services": {
    "web": {
      "root": "apps/web/",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_INTERNAL_URL"
        }
      ]
    },
    "api": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "apps/api/Dockerfile"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ],
  "daemons": {
    "worker": {
      "root": ".",
      "entrypoint": "apps/api/Dockerfile",
      "command": ["sh", "-c", "npm run db:migrate -w @vincent/api && exec npm run start:worker -w @vincent/api"],
      "instances": { "sin1": 1 }
    }
  }
}
